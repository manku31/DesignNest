{
  "name": "designnest-interiors",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=22.12.0"
  },
  "type": "module",
  "scripts": {
    "dev": "concurrently -k -n api,web \"npm:dev:api\" \"npm:dev:web\"",
    "build": "tsc --noEmit && vite build",
    "start": "tsx server/index.ts --production",
    "preview": "vite preview --host 0.0.0.0",
    "lint": "eslint .",
    "test": "npm run build && playwright test",
    "format": "prettier --write src server shared tests *.ts *.mjs index.html README.md",
    "dev:api": "tsx watch server/index.ts",
    "dev:web": "vite --host 0.0.0.0 --port 3000",
    "test:server": "node --import tsx --test server/*.test.ts"
  },
  "dependencies": {
    "express": "^5.2.1",
    "lucide-react": "^0.468.0",
    "multer": "^2.4.0",
    "pannellum": "^2.5.7",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "react-router-dom": "^7.9.0",
    "sharp": "^0.35.4",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@eslint/js": "^9",
    "@playwright/test": "^1.63.0",
    "@tailwindcss/postcss": "^4",
    "@types/express": "^5.0.6",
    "@types/multer": "^2.2.0",
    "@types/node": "^20",
    "@types/pannellum": "^2.5.2",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitejs/plugin-react": "^5.0.0",
    "concurrently": "^10.0.5",
    "eslint": "^9",
    "eslint-plugin-react-hooks": "^5.2.0",
    "globals": "^16.0.0",
    "prettier": "^3.9.9",
    "tailwindcss": "^4",
    "tsx": "^4.23.15",
    "typescript": "^5",
    "typescript-eslint": "^8.0.0",
    "vite": "^7.1.0",
    "wrangler": "4.141.0"
  }
}
